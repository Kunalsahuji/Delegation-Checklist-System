PORT=5080
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Atlas URI (replace with your credentials in local .env)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow-db

JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allowed origins
CORS_ORIGIN=https://delegation-checklist-system.vercel.app,http://localhost:5185
COOKIE_SECRET=your_cookie_secret_here

LOG_LEVEL=info
CRON_ENABLED=true
